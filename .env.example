# 将来のX API接続用
X_API_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2
# false: X API呼び出しを停止（課金防止・既存データ保護）。復旧時は true に設定。
X_API_FETCH_ENABLED=false
X_FETCH_MAX_RESULTS=100
X_FETCH_REQUEST_DELAY_MS=500
X_INITIAL_LOOKBACK_HOURS=72
X_FETCH_MAX_PAGES_PER_SOURCE=3

# 任意: サイトURL（SEO・sitemap用）
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 開発時のみ: DEMO投稿を表示（本番では常に非表示）
SHOW_DEMO_POSTS=true
